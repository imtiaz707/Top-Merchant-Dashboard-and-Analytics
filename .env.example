# ── Mode ─────────────────────────────────────────────────────────────
# Demo mode serves generated sample data and needs nothing else in this file.
# It is on automatically when SHEET_ID is empty. Set DEMO_MODE=false to force live mode.
DEMO_MODE=true

# ── Live mode only ───────────────────────────────────────────────────
# Long random string used to sign session cookies (e.g. `openssl rand -base64 48`).
AUTH_SECRET=

# One password per team. A team with no password cannot sign in.
TEAM_OPERATIONS_PASSWORD=
TEAM_KAM_PASSWORD=
TEAM_BUSINESS_PASSWORD=
TEAM_LEADS_PASSWORD=
# Optional username overrides (default: lowercased team name).
# TEAM_LEADS_USER=

# Google Sheet to read, shared with the service account as Viewer.
SHEET_ID=
# Service account — either inline (Vercel) ...
GOOGLE_CLIENT_EMAIL=
GOOGLE_PRIVATE_KEY=
# ... or a key file (on-prem).
# GOOGLE_APPLICATION_CREDENTIALS=/etc/dashboard/service-account.json

# Secret for POST /api/revalidate (cache purge after each ETL run).
REVALIDATE_SECRET=

# cdn = load ECharts and fonts from CDNs; local = serve /vendor/echarts.min.js, system fonts.
ASSET_MODE=cdn

# Only set to false when serving plain HTTP on a private network.
# COOKIE_SECURE=false
